# Axemere AI Gateway — Go Example Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All examples read from .env in the working directory before falling back to
# environment variables already set in the shell.

AXEMERE_GATEWAY_URL=http://localhost:7080
AXEMERE_WORKLOAD_ID=wl-prod-app-1
AXEMERE_PROJECT_ID=proj-123
AXEMERE_CUSTOMER_ID=cust-42
AXEMERE_ACCOUNT_ID=acct-12

# Managed gateway authentication — leave empty for self-hosted deployments.
# AXEMERE_GATEWAY_TOKEN=axemere_k_...

# Azure OpenAI endpoint (example 08 only).
# Set to your Azure resource hostname, e.g. myresource.openai.azure.com
# AXEMERE_AZURE_ENDPOINT=myresource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Admin token for approval-polling demo (example 06 only).
# MVGC_ADMIN_TOKEN=...
